{
  "private": true,
  "name": "browser-app",
  "version": "0.0.0",
  "dependencies": {
    "@theia/ai-copilot": "1.75.0",
    "@theia/ai-core-ui": "1.75.0",
    "@theia/ai-google": "1.75.0",
    "@theia/ai-history": "1.75.0",
    "@theia/ai-ide": "1.75.0",
    "@theia/ai-mcp-ui": "1.75.0",
    "@theia/ai-ollama": "1.75.0",
    "@theia/ai-openai": "1.75.0",
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/plugin-ext": "1.75.0",
    "@theia/plugin-ext-vscode": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/vsx-registry": "1.75.0",
    "@theia/workspace": "1.75.0",
    "ai-extension": "0.0.0",
    "theia-customization": "0.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0"
  },
  "scripts": {
    "clean": "theia clean",
    "build": "theia build --mode development",
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "theia start --plugins=local-dir:../plugins",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "My Custom Theia Application",
        "warnOnPotentiallyInsecureHostPattern": false,
        "preferences": {
          "workbench.colorTheme": "Custom Theme (Light)",
          "workbench.iconTheme": "vs-minimal"
        }
      }
    }
  }
}
